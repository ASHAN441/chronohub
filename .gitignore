# ===== 仓库历史归档（勿提交）=====
# 原 教务 / 空课表 两个子仓库的 .git 与 bundle 备份
.git_history_backup/

# ===== 助手工作区数据（本地状态，不入库）=====
.workbuddy/

# ===== 启动器记录的本地解释器路径（随机器而异，不入库）=====
.runtime
.deps_installed

# ===== 操作系统 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 编辑器 / IDE =====
.vscode/
.idea/
*.swp
*.swo

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== 构建产物 =====
# PyInstaller 工作目录（build、build2… 都可能出现）
build*/
# 构建产物：dist/ 以及临时构建目录 dist_staging 等
dist*/
# PyInstaller 自动生成的 spec 不入库，但 packaging/ 下手工维护的构建配置要入库
*.spec
!packaging/*.spec

# ===== 临时文件 =====
tmp/
*.log

# ===== 本地用户数据 =====
# 注意：这里不能写全局的 *.pdf —— 教务/ 的导出 PDF 已由它自己的 .gitignore 排除，
# 而 空课表/tests/fixtures/ 下的 PDF 是解析器测试样本，必须入库。
data/

# ===== 界面演示稿（只在本地确认，不上传）=====
# demo-first 流程里每个功能先出一份 HTML 效果稿供确认，确认后就被正式界面取代。
# 这些目录是过程产物，留在本地即可，不进版本库。
*演示/
导出界面demo.html

# ===== 旧子项目源码（已合并进 app/ 与 web/，只在本地留档）=====
# 合并前的 教务/ 与 空课表/ 两份独立实现，仅作移植参考，不再随仓库分发。
# 注意：课表解析的测试样本已迁到 tests/fixtures/，不再依赖这里。
教务/
空课表/
